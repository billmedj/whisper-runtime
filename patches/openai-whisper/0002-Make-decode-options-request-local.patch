+
+
+def _snapshot_options(options: DecodingOptions) -> DecodingOptions:
+    """Detach iterable options from caller-owned mutable or single-use objects."""
+
+    def snapshot_tokens(value):
+        if value is None or isinstance(value, str):
+            return value
+        return tuple(value)
+
+    return replace(
+        options,
+        prompt=snapshot_tokens(options.prompt),
+        prefix=snapshot_tokens(options.prefix),
+        suppress_tokens=snapshot_tokens(options.suppress_tokens),
+    )
 
 
