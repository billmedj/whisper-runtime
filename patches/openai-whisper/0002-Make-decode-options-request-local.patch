@@ -0,0 +1,203 @@
+from types import SimpleNamespace
+from unittest.mock import patch
+
+import torch
+from torch.distributions import Categorical
+
+from whisper.decoding import DecodingOptions, DecodingTask, GreedyDecoder
+
+
+class StubTokenizer:
+    sot = 1
+    sot_prev = 2
+    transcribe = 3
+    translate = 4
+    sot_lm = 5
+    eot = 6
+    no_speech = 7
+    no_timestamps = 8
+    timestamp_begin = 9
+    sot_sequence = (sot,)
+    sot_sequence_including_notimestamps = (sot, no_timestamps)
+    non_speech_tokens = (31, 32)
+
+    @staticmethod
+    def encode(text):
+        return [40]
+
+
+def make_stub_model():
+    return SimpleNamespace(
+        is_multilingual=False,
+        num_languages=99,
+        dims=SimpleNamespace(n_text_ctx=32, n_audio_ctx=4),
+        decoder=SimpleNamespace(blocks=[]),
+    )
+
+
+def make_task(options):
+    with patch("whisper.decoding.get_tokenizer", return_value=StubTokenizer()):
+        return DecodingTask(make_stub_model(), options)
+
+
+def test_decoding_task_snapshots_caller_owned_collections():
+    prompt = [10, 11]
+    prefix = (20, 21)
+    suppress_tokens = [-1, 30]
+    options = DecodingOptions(
+        prompt=prompt,
+        prefix=prefix,
+        suppress_tokens=suppress_tokens,
+        suppress_blank=False,
+        without_timestamps=True,
+        sample_len=2,
+    )
+
+    task = make_task(options)
+
+    assert prompt == [10, 11]
+    assert prefix == (20, 21)
+    assert suppress_tokens == [-1, 30]
+    assert task.options.prompt == (10, 11)
+    assert task.options.prefix == (20, 21)
+    assert task.options.suppress_tokens == (-1, 30)
+    assert task.decoder.generator is None
+    assert task.initial_tokens == (2, 10, 11, 1, 8, 20, 21)
+    assert task.logit_filters[0].suppress_tokens == [
+        1,
+        2,
+        3,
+        4,
+        5,
+        7,
+        30,
+        31,
+        32,
+    ]
+
+    prompt.append(12)
+    suppress_tokens.append(33)
+    assert task.options.prompt == (10, 11)
+    assert task.options.suppress_tokens == (-1, 30)
+
+
+def test_decoding_task_consumes_single_use_option_iterables_once():
+    generator = torch.Generator().manual_seed(13)
+    task = make_task(
+        DecodingOptions(
+            temperature=0.5,
+            prompt=(token for token in [10, 11]),
+            prefix=(token for token in [20, 21]),
+            suppress_tokens=(token for token in [30]),
+            suppress_blank=False,
+            without_timestamps=True,
+            sample_len=2,
+            generator=generator,
+        )
+    )
+
+    assert task.options.prompt == (10, 11)
+    assert task.options.prefix == (20, 21)
+    assert task.options.suppress_tokens == (30,)
+    assert task.decoder.generator is generator
+    assert task.initial_tokens == (2, 10, 11, 1, 8, 20, 21)
+    assert 30 in task.logit_filters[0].suppress_tokens
+
+
+def decoder_step(decoder, tokens, logits, sum_logprobs):
+    tokens, _ = decoder.update(tokens, logits.clone(), sum_logprobs)
+    return tokens
+
+
+def test_default_sampling_keeps_the_legacy_global_rng_path():
+    logits = torch.tensor([[0.2, 0.5, 1.1, -0.3]])
+    tokens = torch.tensor([[0]])
+    sum_logprobs = torch.zeros(1)
+
+    torch.manual_seed(1234)
+    expected = Categorical(logits=logits / 0.7).sample()
+
+    torch.manual_seed(1234)
+    decoder = GreedyDecoder(temperature=0.7, eot=99)
+    actual = decoder_step(decoder, tokens, logits, sum_logprobs)[:, -1]
+
+    torch.testing.assert_close(actual, expected)
+
+
+def test_request_local_generators_are_reproducible_under_interleaving():
+    logits = torch.tensor(
+        [[0.2, 0.5, 1.1, -0.3], [1.0, -0.4, 0.3, 0.8]],
+        dtype=torch.float32,
+    )
+
+    def make_decoder(seed):
+        generator = torch.Generator().manual_seed(seed)
+        return GreedyDecoder(temperature=0.8, eot=99, generator=generator)
+
+    def initial_state():
+        return torch.tensor([[0], [1]]), torch.zeros(2)
+
+    reference = make_decoder(17)
+    reference_tokens, reference_logprobs = initial_state()
+    for _ in range(8):
+        reference_tokens = decoder_step(
+            reference, reference_tokens, logits, reference_logprobs
+        )
+
+    decoder_a = make_decoder(17)
+    decoder_b = make_decoder(91)
+    tokens_a, logprobs_a = initial_state()
+    tokens_b, logprobs_b = initial_state()
+    for _ in range(8):
+        tokens_a = decoder_step(decoder_a, tokens_a, logits, logprobs_a)
+        tokens_b = decoder_step(decoder_b, tokens_b, logits, logprobs_b)
+
+    torch.testing.assert_close(tokens_a, reference_tokens)
+    torch.testing.assert_close(logprobs_a, reference_logprobs)
+
+
+def test_request_local_sampling_does_not_advance_the_global_rng():
+    decoder = GreedyDecoder(
+        temperature=0.9,
+        eot=99,
+        generator=torch.Generator().manual_seed(7),
+    )
+    logits = torch.tensor([[0.1, 0.4, 0.8]])
+    tokens = torch.tensor([[0]])
+    sum_logprobs = torch.zeros(1)
+
+    torch.manual_seed(2026)
+    before = torch.random.get_rng_state()
+    decoder_step(decoder, tokens, logits, sum_logprobs)
+    after = torch.random.get_rng_state()
+
+    torch.testing.assert_close(after, before)
+
+
+def test_request_local_sampling_advances_the_supplied_generator():
+    generator = torch.Generator().manual_seed(7)
+    decoder = GreedyDecoder(temperature=0.9, eot=99, generator=generator)
+    logits = torch.tensor([[0.1, 0.4, 0.8]])
+    tokens = torch.tensor([[0]])
+    sum_logprobs = torch.zeros(1)
+
+    before = generator.get_state().clone()
+    decoder_step(decoder, tokens, logits, sum_logprobs)
+
+    assert not torch.equal(generator.get_state(), before)
+
+
+def test_decoding_task_rejects_non_torch_generator():
+    options = DecodingOptions(
+        generator=object(),
+        suppress_blank=False,
+        suppress_tokens=(),
+        without_timestamps=True,
+    )
+
+    try:
+        make_task(options)
+    except TypeError as exc:
+        assert str(exc) == "generator must be a torch.Generator"
+    else:
+        raise AssertionError("DecodingTask accepted an invalid generator")
