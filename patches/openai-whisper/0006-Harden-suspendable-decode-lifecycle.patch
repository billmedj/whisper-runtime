+def test_cleanup_waits_for_an_in_flight_step_and_cancellation_wins(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    run.prefill()
+    assert run.decoder is not None
+    assert run.inference is not None
+
+    update_entered = Event()
+    allow_update = Event()
+    cleanup_started = Event()
+    original_update = run.decoder.update
+    original_cleanup = run.inference.cleanup_caching
+
+    def blocked_update(*args, **kwargs):
+        update_entered.set()
+        assert allow_update.wait(timeout=10)
+        tokens, _ = original_update(*args, **kwargs)
+        return tokens, False
+
+    def cancel():
+        cleanup_started.set()
+        run.cleanup()
+
+    with (
+        patch.object(run.decoder, "update", side_effect=blocked_update),
+        patch.object(
+            run.inference, "cleanup_caching", wraps=original_cleanup
+        ) as cleanup_spy,
+        ThreadPoolExecutor(max_workers=2) as executor,
+    ):
+        step_future = executor.submit(run.step)
+        assert update_entered.wait(timeout=10)
+        cleanup_future = executor.submit(cancel)
+        assert cleanup_started.wait(timeout=10)
+        assert cleanup_spy.call_count == 0
+
+        allow_update.set()
+        assert step_future.result(timeout=10) is False
+        cleanup_future.result(timeout=10)
+        assert cleanup_spy.call_count == 1
+
+    with pytest.raises(RuntimeError, match="decode run is cancelled"):
+        run.step()
+
+
+def test_cleanup_failure_is_retryable_and_releases_terminal_state_after_success(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    assert run.inference is not None
+    inference = run.inference
+
+    with patch.object(
+        inference,
+        "cleanup_caching",
+        side_effect=[RuntimeError("first cleanup failed"), None],
+    ) as cleanup_spy:
+        with pytest.raises(RuntimeError, match="first cleanup failed"):
+            run.cleanup()
+        assert run.inference is inference
+
+        run.cleanup()
+        run.cleanup()
+        assert cleanup_spy.call_count == 2
+
+    assert run.inference is None
+    assert run.decoder is None
+    assert run.audio_features is None
+    assert run.tokens is None
+    assert run.sum_logprobs is None
+
+
+def test_decode_error_remains_primary_when_cleanup_also_fails(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    assert run.inference is not None
+    inference = run.inference
+
+    with (
+        patch.object(inference, "logits", side_effect=ValueError("decode failed")),
+        patch.object(
+            inference,
+            "cleanup_caching",
+            side_effect=[RuntimeError("cleanup failed"), None],
+        ) as cleanup_spy,
+    ):
+        with pytest.raises(ValueError, match="decode failed") as exc_info:
+            run.prefill()
+        assert any("cleanup also failed" in note for note in exc_info.value.__notes__)
+
+        run.cleanup()
+        assert cleanup_spy.call_count == 2
+
+    assert run.inference is None
