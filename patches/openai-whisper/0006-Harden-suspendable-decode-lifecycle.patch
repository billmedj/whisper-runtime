+def test_legacy_extension_runs_share_one_lock_per_model():
+    first_entered = Event()
+    allow_first = Event()
+    second_entered = Event()
+
+    class BlockingTask(DecodingTask):
+        def __init__(self, *args, entered, release=None, **kwargs):
+            self._entered = entered
+            self._release = release
+            super().__init__(*args, **kwargs)
+
+        def _main_loop(self, audio_features, tokens):
+            self._entered.set()
+            if self._release is not None:
+                assert self._release.wait(timeout=10)
+            return super()._main_loop(audio_features, tokens)
+
+    model = make_public_decode_model()
+    options = DecodingOptions(
+        language="en",
+        sample_len=1,
+        suppress_blank=False,
+        suppress_tokens=(),
+        without_timestamps=True,
+        fp16=False,
+    )
+    first = BlockingTask(model, options, entered=first_entered, release=allow_first)
+    second = BlockingTask(model, options, entered=second_entered)
+    features = torch.randn(1, 4, 4)
+
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        first_future = executor.submit(first.run, features)
+        assert first_entered.wait(timeout=10)
+        second_future = executor.submit(second.run, features)
+        assert not second_entered.wait(timeout=0.2)
+        allow_first.set()
+        assert len(first_future.result(timeout=10)) == 1
+        assert len(second_future.result(timeout=10)) == 1
+
+    assert second_entered.is_set()
+
