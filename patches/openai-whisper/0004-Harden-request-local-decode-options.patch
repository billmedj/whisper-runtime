+def test_distinct_generators_are_reproducible_during_concurrent_sampling():
+    logits = torch.tensor(
+        [[0.2, 0.5, 1.1, -0.3], [1.0, -0.4, 0.3, 0.8]],
+        dtype=torch.float32,
+    )
+
+    def sample(seed, barrier=None):
+        decoder = GreedyDecoder(
+            temperature=0.8,
+            eot=99,
+            generator=torch.Generator().manual_seed(seed),
+        )
+        tokens = torch.tensor([[0], [1]])
+        sum_logprobs = torch.zeros(2)
+        for _ in range(16):
+            if barrier is not None:
+                barrier.wait(timeout=10)
+            tokens = decoder_step(decoder, tokens, logits, sum_logprobs)
+        return tokens, sum_logprobs
+
+    expected_a = sample(17)
+    expected_b = sample(91)
+    barrier = Barrier(2)
+    with ThreadPoolExecutor(max_workers=2) as executor:
+        future_a = executor.submit(sample, 17, barrier)
+        future_b = executor.submit(sample, 91, barrier)
+        actual_a = future_a.result(timeout=30)
+        actual_b = future_b.result(timeout=30)
+
+    for actual, expected in zip(actual_a, expected_a):
+        torch.testing.assert_close(actual, expected)
+    for actual, expected in zip(actual_b, expected_b):
+        torch.testing.assert_close(actual, expected)
+
+
