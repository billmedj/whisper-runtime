+def test_public_decode_uses_local_sampling_without_mutating_option_lists():
+    model = make_public_decode_model()
+    mel = torch.linspace(-1, 1, 32).reshape(4, 8)
+    prompt = [100]
+    prefix = [101]
+    suppress_tokens = [30]
+    generator = torch.Generator().manual_seed(9)
+    generator_before = generator.get_state().clone()
+    torch.manual_seed(2026)
+    global_before = torch.random.get_rng_state()
+
+    result = decode(
+        model,
+        mel,
+        DecodingOptions(
+            language="en",
+            temperature=0.7,
+            sample_len=1,
+            prompt=prompt,
+            prefix=prefix,
+            suppress_tokens=suppress_tokens,
+            suppress_blank=False,
+            without_timestamps=True,
+            fp16=False,
+            generator=generator,
+        ),
+    )
+
+    assert isinstance(result, DecodingResult)
+    assert prompt == [100]
+    assert prefix == [101]
+    assert suppress_tokens == [30]
+    assert not torch.equal(generator.get_state(), generator_before)
+    torch.testing.assert_close(torch.random.get_rng_state(), global_before)
+
+
