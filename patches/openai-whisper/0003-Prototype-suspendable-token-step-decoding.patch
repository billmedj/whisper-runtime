diff --git a/tests/test_suspendable_decode.py b/tests/test_suspendable_decode.py
new file mode 100644
index 0000000..2db87e8
--- /dev/null
+++ b/tests/test_suspendable_decode.py
@@ -0,0 +1,210 @@
+from unittest.mock import patch
+
+import pytest
+import torch
+
+from whisper.decoding import DecodingOptions, DecodingTask
+from whisper.model import ModelDimensions, Whisper
+
+
+@pytest.fixture
+def model() -> Whisper:
+    torch.manual_seed(0)
+    dimensions = ModelDimensions(
+        n_mels=80,
+        n_audio_ctx=2,
+        n_audio_state=4,
+        n_audio_head=1,
+        n_audio_layer=1,
+        n_vocab=51864,
+        n_text_ctx=12,
+        n_text_state=4,
+        n_text_head=1,
+        n_text_layer=1,
+    )
+    model = Whisper(dimensions).eval()
+    for parameter in model.parameters():
+        torch.nn.init.normal_(parameter, mean=0.0, std=0.02)
+    return model
+
+
+@pytest.fixture
+def audio_features() -> torch.Tensor:
+    torch.manual_seed(1)
+    return torch.randn(1, 2, 4)
+
+
+def make_options(**kwargs) -> DecodingOptions:
+    defaults = dict(
+        language="en",
+        sample_len=4,
+        suppress_blank=False,
+        suppress_tokens=(),
+        without_timestamps=True,
+        fp16=False,
+    )
+    defaults.update(kwargs)
+    return DecodingOptions(**defaults)
+
+
+def run_with_pause(
+    model: Whisper, audio_features: torch.Tensor, options: DecodingOptions
+):
+    run = DecodingTask(model, options)._start_run(audio_features)
+    initial_tokens = run.tokens.clone()
+    run.prefill()
+    assert run.step_index == 0
+    assert torch.equal(run.tokens, initial_tokens)
+
+    run.step()
+    checkpoint = run.tokens.clone()
+    assert run.step_index == 1
+    assert run.tokens.shape[-1] == initial_tokens.shape[-1] + 1
+    assert torch.equal(run.tokens, checkpoint)
+
+    while not run.complete:
+        run.step()
+    return run.finalize()
+
+
+def assert_results_equal(actual, expected) -> None:
+    assert len(actual) == len(expected)
+    for actual_result, expected_result in zip(actual, expected):
+        assert actual_result.language == expected_result.language
+        assert actual_result.language_probs == expected_result.language_probs
+        assert actual_result.tokens == expected_result.tokens
+        assert actual_result.text == expected_result.text
+        assert actual_result.avg_logprob == pytest.approx(expected_result.avg_logprob)
+        assert actual_result.no_speech_prob == pytest.approx(
+            expected_result.no_speech_prob
+        )
+        assert actual_result.temperature == expected_result.temperature
+        assert actual_result.compression_ratio == expected_result.compression_ratio
+        torch.testing.assert_close(
+            actual_result.audio_features, expected_result.audio_features
+        )
+
+
+def test_paused_greedy_decode_matches_uninterrupted_run(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    options = make_options()
+
+    uninterrupted = DecodingTask(model, options).run(audio_features)
+    resumed = run_with_pause(model, audio_features, options)
+
+    assert_results_equal(resumed, uninterrupted)
+
+
+def test_paused_sampling_decode_preserves_request_local_rng(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    uninterrupted_generator = torch.Generator().manual_seed(17)
+    resumed_generator = torch.Generator().manual_seed(17)
+
+    uninterrupted = DecodingTask(
+        model,
+        make_options(temperature=0.8, generator=uninterrupted_generator),
+    ).run(audio_features)
+    resumed = run_with_pause(
+        model,
+        audio_features,
+        make_options(temperature=0.8, generator=resumed_generator),
+    )
+
+    assert_results_equal(resumed, uninterrupted)
+    torch.testing.assert_close(
+        resumed_generator.get_state(), uninterrupted_generator.get_state()
+    )
+
+
+def test_paused_beam_decode_matches_uninterrupted_run(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    options = make_options(beam_size=2)
+
+    uninterrupted = DecodingTask(model, options).run(audio_features)
+    resumed = run_with_pause(model, audio_features, options)
+
+    assert_results_equal(resumed, uninterrupted)
+
+
+def test_inference_cleanup_runs_exactly_once(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    assert run.inference is not None
+
+    cleanup = run.inference.cleanup_caching
+    with patch.object(run.inference, "cleanup_caching", wraps=cleanup) as cleanup_spy:
+        run.prefill()
+        while not run.complete:
+            run.step()
+        assert cleanup_spy.call_count == 1
+
+        run.finalize()
+        run.cleanup()
+        assert cleanup_spy.call_count == 1
+
+
+def test_two_runs_do_not_alias_mutable_decode_state(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    task = DecodingTask(model, make_options(beam_size=2))
+    first = task._start_run(audio_features)
+    second = task._start_run(audio_features)
+
+    assert first.inference is not second.inference
+    assert first.decoder is not second.decoder
+    assert first.tokens.data_ptr() != second.tokens.data_ptr()
+    assert first.sum_logprobs.data_ptr() != second.sum_logprobs.data_ptr()
+    assert first.no_speech_probs is not second.no_speech_probs
+    assert first.inference.kv_cache is not second.inference.kv_cache
+
+    try:
+        first.prefill()
+        second.prefill()
+        first.step()
+        second.step()
+
+        assert first.decoder.finished_sequences is not second.decoder.finished_sequences
+        assert first.inference.kv_cache is not second.inference.kv_cache
+    finally:
+        first.cleanup()
+        second.cleanup()
+
+
+def test_finalized_run_rejects_reuse(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    while not run.complete:
+        run.step()
+    run.finalize()
+
+    with pytest.raises(RuntimeError, match="decode run is finalized"):
+        run.prefill()
+    with pytest.raises(RuntimeError, match="decode run is finalized"):
+        run.step()
+    with pytest.raises(RuntimeError, match="decode run is finalized"):
+        run.finalize()
+
+
+def test_cancelled_run_rejects_further_work(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    run = DecodingTask(model, make_options())._start_run(audio_features)
+    assert run.inference is not None
+    cleanup = run.inference.cleanup_caching
+    with patch.object(run.inference, "cleanup_caching", wraps=cleanup) as cleanup_spy:
+        run.prefill()
+        run.cleanup()
+        run.cleanup()
+        assert cleanup_spy.call_count == 1
+
+    with pytest.raises(RuntimeError, match="decode run is cancelled"):
+        run.prefill()
+    with pytest.raises(RuntimeError, match="decode run is cancelled"):
+        run.step()
+    with pytest.raises(RuntimeError, match="decode run is cancelled"):
+        run.finalize()
