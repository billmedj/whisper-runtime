+def test_legacy_cache_lock_is_held_until_retryable_cleanup_succeeds(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    first_task = DecodingTask(model, make_options())
+    second_task = DecodingTask(model, make_options())
+    second_components_created = Event()
+    original_new_components = second_task._new_run_components
+
+    def tracked_new_components():
+        components = original_new_components()
+        second_components_created.set()
+        return components
+
+    second_task._new_run_components = tracked_new_components
+
+    with (
+        patch.object(
+            PyTorchInference, "_supports_request_local_cache", return_value=False
+        ),
+        ThreadPoolExecutor(max_workers=1) as executor,
+    ):
+        first = first_task._start_run(audio_features)
+        assert first.inference is not None
+        original_cleanup = first.inference.cleanup_caching
+        cleanup_calls = 0
+
+        def flaky_cleanup():
+            nonlocal cleanup_calls
+            cleanup_calls += 1
+            if cleanup_calls == 1:
+                raise RuntimeError("cleanup failed")
+            original_cleanup()
+
+        second_future = executor.submit(second_task._start_run, audio_features)
+        assert second_components_created.wait(timeout=10)
+        assert not second_future.done()
+
+        with patch.object(
+            first.inference, "cleanup_caching", side_effect=flaky_cleanup
+        ):
+            with pytest.raises(RuntimeError, match="cleanup failed"):
+                first.cleanup()
+            assert not second_future.done()
+            first.cleanup()
+
+        second = second_future.result(timeout=10)
+        second.cleanup()
+
+
+def test_paused_legacy_cache_run_blocks_legacy_extension_on_same_model(
+    model: Whisper, audio_features: torch.Tensor
+) -> None:
+    extension_entered = Event()
+
+    class LegacyExtensionTask(DecodingTask):
+        def _main_loop(self, audio_features, tokens):
+            extension_entered.set()
+            return super()._main_loop(audio_features, tokens)
+
+    suspended_task = DecodingTask(model, make_options())
+    extension_task = LegacyExtensionTask(model, make_options(sample_len=1))
+
+    with (
+        patch.object(
+            PyTorchInference, "_supports_request_local_cache", return_value=False
+        ),
+        ThreadPoolExecutor(max_workers=1) as executor,
+    ):
+        suspended = suspended_task._start_run(audio_features)
+        extension_future = executor.submit(extension_task.run, audio_features)
+        assert not extension_entered.wait(timeout=0.2)
+
+        suspended.cleanup()
+        assert len(extension_future.result(timeout=10)) == 1
+
+    assert extension_entered.is_set()
