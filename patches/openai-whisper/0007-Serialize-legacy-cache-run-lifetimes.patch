+def _legacy_run_lock(model: "Whisper"):
     """Return the lock that serializes legacy mutable cache state for a model."""
 
     with _legacy_run_locks_guard:
         model_id = id(model)
         lock = _legacy_run_locks.get(model_id)
         if lock is None:
-            lock = RLock()
+            # A paused run can be resumed or cancelled by another thread, so
+            # this lock must not have thread ownership semantics.
+            lock = Lock()
             _legacy_run_locks[model_id] = lock
         return lock
 
 
+def _record_cleanup_error(
+    primary_error: BaseException, cleanup_error: BaseException
+) -> None:
+    """Attach cleanup diagnostics without replacing the primary exception."""
+
+    try:
+        primary_error.whisper_cleanup_error = cleanup_error
+    except (AttributeError, TypeError):
+        pass
+
+
+def _component_fingerprint(component, method_names: Tuple[str, ...]):
+    """Capture extension-visible component state without comparing tensors."""
+
+    def value_marker(value):
+        if value is None or isinstance(value, (bool, int, float, str, bytes)):
+            return ("value", value)
+        if isinstance(value, (dict, list, set, tuple)):
+            return ("container", id(value), len(value))
+        return ("identity", id(value))
+
+    state = tuple(
+        sorted((name, value_marker(value)) for name, value in vars(component).items())
+    )
+    methods = tuple(id(getattr(type(component), name, None)) for name in method_names)
+    return type(component), state, methods
+
