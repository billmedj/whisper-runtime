include LICENSE
include NOTICE
include README.md
include CITATION.cff
include CONTRIBUTING.md
include SECURITY.md
include THIRD_PARTY_NOTICES.md
include pyproject.toml
recursive-include conformance *.json *.md
recursive-include constraints *.txt
recursive-include docs *.md
recursive-include evidence *.json *.jsonl *.md
recursive-include experiments *.json
recursive-include examples *.py
recursive-include infra *.py
recursive-include infra *.lock
